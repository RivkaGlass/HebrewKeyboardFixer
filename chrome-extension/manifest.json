{
  "manifest_version": 3,
  "name": "מתקן מקלדת עברית",
  "version": "1.0",
  "description": "הופך טקסט שהוקלד באנגלית בטעות לעברית",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "fix-text": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "הפוך טקסט מסומן"
    }
  }
}